<clickhouse>
    <iceberg>
        <!-- Enable Iceberg Engine -->
        <enable>true</enable>

        <!-- REST Catalog Configuration -->
        <catalog>
            <type>rest</type>
            <uri>http://iceberg_rest:8181/</uri>
            <warehouse>s3://project-bucket/</warehouse>
        </catalog>

        <!-- S3 Storage Configuration -->
        <s3>
            <endpoint>http://minio:9000</endpoint>
            <access_key_id>minioadmin</access_key_id>
            <secret_access_key>minioadmin</secret_access_key>
            <region>us-east-1</region>

            <!-- Iceberg needs path-style for MinIO -->
            <use_environment_credentials>false</use_environment_credentials>
            <force_path_style>true</force_path_style>
        </s3>
    </iceberg>
</clickhouse>
