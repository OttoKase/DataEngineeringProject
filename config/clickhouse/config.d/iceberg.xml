<clickhouse>
    <profiles>
        <default>
            <allow_experimental_database_iceberg>true</allow_experimental_database_iceberg>
            <allow_database_iceberg>true</allow_database_iceberg>
        </default>
    </profiles>

    <iceberg>
        <enable>true</enable>

        <catalog>
            <type>rest</type>
            <uri>http://iceberg_rest:8181/</uri>
            <warehouse>s3://project-bucket/</warehouse>
        </catalog>

        <s3>
            <endpoint>http://minio:9000</endpoint>
            <access_key_id>minioadmin</access_key_id>
            <secret_access_key>minioadmin</secret_access_key>
            <region>us-east-1</region>
            <force_path_style>true</force_path_style>
        </s3>
    </iceberg>
</clickhouse>


